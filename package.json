{
  "name": "agentropolis",
  "version": "1.1.0",
  "description": "A small, dependency-light framework for building agents and orchestrating them with sequential, parallel, conversational and graph workflows — with a CLI and an optional live city dashboard.",
  "type": "module",
  "license": "MIT",
  "main": "./src/framework/index.mjs",
  "bin": {
    "agentropolis": "./bin/agentropolis.mjs"
  },
  "exports": {
    ".": "./src/framework/index.mjs",
    "./cli": "./src/cli/index.mjs",
    "./agent": "./src/framework/Agent.mjs",
    "./workflow": "./src/framework/Workflow.mjs",
    "./tool": "./src/framework/Tool.mjs",
    "./orchestrator": "./src/framework/Orchestrator.mjs",
    "./loader": "./src/framework/Loader.mjs",
    "./city": "./src/citySchema.mjs",
    "./engine": "./src/engine.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "examples/",
    "config/",
    "server.js",
    "README.md",
    "ONBOARDING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agents",
    "llm",
    "workflow",
    "orchestration",
    "multi-agent",
    "tools",
    "yaml"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/framework.test.js test/loader.test.js test/integration.test.js test/cli.test.js test/engine.test.js test/city.test.js test/schema.test.js",
    "test:framework": "node --test test/framework.test.js test/loader.test.js test/integration.test.js",
    "test:cli": "node --test test/cli.test.js",
    "test:city": "node --test test/engine.test.js test/city.test.js test/schema.test.js",
    "test:server": "node scripts/probe-server.mjs",
    "validate-city": "node src/validateCity.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
